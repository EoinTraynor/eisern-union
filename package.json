{
  "name": "eisern-union-bot",
  "version": "1.0.0",
  "description": "FC Union Berlin",
  "main": "src/bot.ts",
  "scripts": {
    "auth": "tsx --env-file=.env src/auth.ts",
    "start:dev": "tsx --watch --env-file=.env src/bot.ts",
    "start": "npm run build && node --env-file=.env build/bot.js",
    "build": "node -e \"fs.rmSync('./build', { force: true, recursive: true })\" && tsc",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix"
  },
  "author": "eointraynor1@gmail.com",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^20.5.6",
    "@typescript-eslint/eslint-plugin": "^6.4.1",
    "@typescript-eslint/parser": "^6.4.1",
    "eslint": "^8.48.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.1",
    "tsx": "^4.7.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "playwright": "^1.58.2"
  }
}
